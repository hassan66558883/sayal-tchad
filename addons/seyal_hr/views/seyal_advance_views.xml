<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seyal_advance_tree" model="ir.ui.view">
        <field name="name">seyal.advance.tree</field>
        <field name="model">seyal.advance</field>
        <field name="arch" type="xml">
            <tree string="Avances sur salaire" decoration-muted="state == 'cancelled'">
                <field name="reference"/>
                <field name="employee_id"/>
                <field name="advance_date"/>
                <field name="amount" sum="Total"/>
                <field name="payslip_id"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_seyal_advance_form" model="ir.ui.view">
        <field name="name">seyal.advance.form</field>
        <field name="model">seyal.advance</field>
        <field name="arch" type="xml">
            <form string="Avance sur salaire">
                <header>
                    <button name="action_approve" type="object" string="Approuver" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label text-muted">Reference</span>
                        <h1><field name="reference" readonly="1"/></h1>
                    </div>
                    <group>
                        <field name="employee_id"/>
                        <field name="advance_date"/>
                        <field name="amount"/>
                        <field name="reason"/>
                        <field name="payslip_id"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_seyal_advance" model="ir.actions.act_window">
        <field name="name">Avances sur salaire</field>
        <field name="res_model">seyal.advance</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
