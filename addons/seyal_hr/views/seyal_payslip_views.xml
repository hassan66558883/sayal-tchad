<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seyal_payslip_tree" model="ir.ui.view">
        <field name="name">seyal.payslip.tree</field>
        <field name="model">seyal.payslip</field>
        <field name="arch" type="xml">
            <tree string="Bulletins de salaire">
                <field name="reference"/>
                <field name="employee_id"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="base_salary"/>
                <field name="advances_deducted"/>
                <field name="net_salary" sum="Total"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_seyal_payslip_form" model="ir.ui.view">
        <field name="name">seyal.payslip.form</field>
        <field name="model">seyal.payslip</field>
        <field name="arch" type="xml">
            <form string="Bulletin de salaire">
                <header>
                    <button name="action_validate" type="object" string="Valider" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_mark_paid" type="object" string="Marquer payee" class="oe_highlight"
                            invisible="state != 'validated'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label text-muted">Reference</span>
                        <h1><field name="reference" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Periode">
                            <field name="employee_id"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                        </group>
                        <group string="Calcul">
                            <field name="base_salary"/>
                            <field name="advances_deducted" readonly="1"/>
                            <field name="net_salary" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Avances deduites">
                            <field name="advance_ids" readonly="1">
                                <tree>
                                    <field name="reference"/>
                                    <field name="advance_date"/>
                                    <field name="amount"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_seyal_payslip" model="ir.actions.act_window">
        <field name="name">Bulletins de salaire</field>
        <field name="res_model">seyal.payslip</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
