<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seyal_department_tree" model="ir.ui.view">
        <field name="name">seyal.department.tree</field>
        <field name="model">seyal.department</field>
        <field name="arch" type="xml">
            <tree string="Departements">
                <field name="code"/>
                <field name="name"/>
                <field name="branch_id"/>
                <field name="manager_id"/>
            </tree>
        </field>
    </record>

    <record id="view_seyal_department_form" model="ir.ui.view">
        <field name="name">seyal.department.form</field>
        <field name="model">seyal.department</field>
        <field name="arch" type="xml">
            <form string="Departement">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="branch_id"/>
                        <field name="manager_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_seyal_department" model="ir.actions.act_window">
        <field name="name">Departements</field>
        <field name="res_model">seyal.department</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
