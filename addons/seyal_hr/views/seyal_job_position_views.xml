<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seyal_job_position_tree" model="ir.ui.view">
        <field name="name">seyal.job.position.tree</field>
        <field name="model">seyal.job.position</field>
        <field name="arch" type="xml">
            <tree string="Postes">
                <field name="code"/>
                <field name="name"/>
                <field name="department_id"/>
            </tree>
        </field>
    </record>

    <record id="view_seyal_job_position_form" model="ir.ui.view">
        <field name="name">seyal.job.position.form</field>
        <field name="model">seyal.job.position</field>
        <field name="arch" type="xml">
            <form string="Poste">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="department_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_seyal_job_position" model="ir.actions.act_window">
        <field name="name">Postes</field>
        <field name="res_model">seyal.job.position</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
