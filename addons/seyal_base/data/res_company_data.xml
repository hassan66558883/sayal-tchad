<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Societe SEYAL-TCHAD (distribution/importation), distincte de la
         societe des eaux (STE) deja presente dans cette instance. Pays et
         devise sont des faits (Tchad -> XAF), pas des donnees commerciales
         inventees. Adresse/logo laisses vides : a completer par le client,
         RULE "ne pas inventer de donnees commerciales reelles". -->
    <record id="seyal_company" model="res.company">
        <field name="name">SEYAL-TCHAD</field>
        <field name="country_id" ref="base.td"/>
        <field name="currency_id" ref="base.XAF"/>
    </record>
</odoo>
