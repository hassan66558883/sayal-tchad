<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seyal_branch_tree" model="ir.ui.view">
        <field name="name">seyal.branch.tree</field>
        <field name="model">seyal.branch</field>
        <field name="arch" type="xml">
            <tree string="Agences">
                <field name="code"/>
                <field name="name"/>
                <field name="city"/>
                <field name="phone"/>
                <field name="manager_id"/>
                <field name="active" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_seyal_branch_form" model="ir.ui.view">
        <field name="name">seyal.branch.form</field>
        <field name="model">seyal.branch</field>
        <field name="arch" type="xml">
            <form string="Agence">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="address"/>
                        <field name="city"/>
                        <field name="phone"/>
                        <field name="manager_id"/>
                        <field name="company_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_seyal_branch" model="ir.actions.act_window">
        <field name="name">Agences</field>
        <field name="res_model">seyal.branch</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
