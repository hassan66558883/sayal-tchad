<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seyal_report_export_wizard_form" model="ir.ui.view">
        <field name="name">seyal.report.export.wizard.form</field>
        <field name="model">seyal.report.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Exporter un rapport">
                <group>
                    <field name="report_type"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_export_pdf" type="object" string="Exporter en PDF" class="oe_highlight"/>
                    <button name="action_export_xlsx" type="object" string="Exporter en Excel" class="oe_highlight"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_seyal_report_export_wizard" model="ir.actions.act_window">
        <field name="name">Exporter un rapport</field>
        <field name="res_model">seyal.report.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
