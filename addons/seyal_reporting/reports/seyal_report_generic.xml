<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_seyal_generic" model="ir.actions.report">
        <field name="name">Rapport SEYAL-TCHAD</field>
        <field name="model">seyal.report.export.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">seyal_reporting.report_seyal_generic_document</field>
        <field name="report_file">seyal_reporting.report_seyal_generic_document</field>
        <field name="print_report_name">'Rapport - %s' % (object.get_report_title())</field>
    </record>

    <template id="report_seyal_generic_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <span t-esc="o.get_report_title()"/>
                        </h2>
                        <p>
                            Periode : <span t-esc="o.date_from"/> - <span t-esc="o.date_to"/>
                        </p>
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <t t-foreach="o.get_report_columns()" t-as="col">
                                        <th><t t-esc="col"/></th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.get_report_rows()" t-as="row">
                                    <t t-foreach="row" t-as="cell">
                                        <td><t t-esc="cell"/></td>
                                    </t>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
