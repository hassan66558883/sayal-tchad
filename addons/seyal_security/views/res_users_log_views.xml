<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- res.users.log (modele natif Odoo, module base) n'a que create_uid/
         create_date comme champs reels - verifie contre le source Odoo
         17.0 avant d'ecrire cette vue (aucun autre champ n'existe sur ce
         modele). Un enregistrement y est cree a chaque connexion reussie
         (res.users._update_last_login()) - c'est deja l'historique complet
         des connexions demande par le cahier des charges, il ne restait
         qu'a l'exposer dans une vue. -->
    <record id="view_seyal_res_users_log_tree" model="ir.ui.view">
        <field name="name">res.users.log.tree.seyal</field>
        <field name="model">res.users.log</field>
        <field name="arch" type="xml">
            <tree string="Historique des connexions" create="false" edit="false" delete="false">
                <field name="create_uid" string="Utilisateur"/>
                <field name="create_date" string="Date de connexion"/>
            </tree>
        </field>
    </record>

    <record id="action_seyal_res_users_log" model="ir.actions.act_window">
        <field name="name">Historique des connexions</field>
        <field name="res_model">res.users.log</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem id="menu_seyal_res_users_log" name="Historique des connexions"
              parent="seyal_base.menu_seyal_administration"
              action="action_seyal_res_users_log" sequence="30"
              groups="base.group_system,group_seyal_direction_generale"/>
</odoo>
