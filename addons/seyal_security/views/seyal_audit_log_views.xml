<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seyal_audit_log_tree" model="ir.ui.view">
        <field name="name">seyal.audit.log.tree</field>
        <field name="model">seyal.audit.log</field>
        <field name="arch" type="xml">
            <tree string="Journal d'audit" create="false" edit="false" delete="false">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="action"/>
                <field name="model_name"/>
                <field name="record_name"/>
            </tree>
        </field>
    </record>

    <record id="action_seyal_audit_log" model="ir.actions.act_window">
        <field name="name">Journal d'audit</field>
        <field name="res_model">seyal.audit.log</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem id="menu_seyal_audit_log" name="Journal d'audit" parent="seyal_base.menu_seyal_administration"
              action="action_seyal_audit_log" sequence="20"
              groups="base.group_system,group_seyal_direction_generale"/>
</odoo>
