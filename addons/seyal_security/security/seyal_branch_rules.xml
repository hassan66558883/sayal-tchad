<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Restriction par agence pour le role "Responsable d'agence", meme
        principe que rule_ste_center_responsable_centre (ste_security) :
        ir.rule filtre les LIGNES parmi ce que ir.model.access accorde deja,
        via res.users.seyal_branch_ids (voir models/res_users.py). Un
        utilisateur sans agence assignee ne voit aucune agence - deliberement,
        pour eviter qu'un compte "Responsable d'agence" mal configure ne
        voie par defaut toutes les agences.

        Les modules metier des phases suivantes (produits, ventes, stocks,
        etc.) ajouteront leurs propres regles sur ce meme modele quand leurs
        enregistrements seront rattaches a une agence.
    -->
    <record id="rule_seyal_branch_responsable_agence" model="ir.rule">
        <field name="name">Responsable d'agence : uniquement ses agences</field>
        <field name="model_id" ref="seyal_base.model_seyal_branch"/>
        <field name="domain_force">[('id', 'in', user.seyal_branch_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_seyal_responsable_agence'))]"/>
    </record>
</odoo>
