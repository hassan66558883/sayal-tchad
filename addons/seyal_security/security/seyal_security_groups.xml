<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_seyal" model="ir.module.category">
        <field name="name">SEYAL-TCHAD - Roles metier</field>
        <field name="sequence">51</field>
    </record>

    <record id="group_seyal_achats" model="res.groups">
        <field name="name">Achats</field>
        <field name="category_id" ref="module_category_seyal"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Fournisseurs, commandes d'achat, importations, conteneurs, reception.</field>
    </record>

    <record id="group_seyal_ventes" model="res.groups">
        <field name="name">Ventes</field>
        <field name="category_id" ref="module_category_seyal"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Clients, devis, commandes, factures de vente.</field>
    </record>

    <record id="group_seyal_stock" model="res.groups">
        <field name="name">Stock / Entrepot</field>
        <field name="category_id" ref="module_category_seyal"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Entrees, sorties, transferts, inventaires, lots.</field>
    </record>

    <record id="group_seyal_logistique" model="res.groups">
        <field name="name">Logistique / Distribution</field>
        <field name="category_id" ref="module_category_seyal"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Tournees, livraisons, vehicules, chauffeurs.</field>
    </record>

    <record id="group_seyal_chauffeur" model="res.groups">
        <field name="name">Chauffeur</field>
        <field name="category_id" ref="module_category_seyal"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Consultation et confirmation de ses propres livraisons (preuve de livraison).</field>
    </record>

    <record id="group_seyal_comptable" model="res.groups">
        <field name="name">Comptable / Finance</field>
        <field name="category_id" ref="module_category_seyal"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Caisse, banques, creances, dettes fournisseurs, depenses.</field>
    </record>

    <record id="group_seyal_caissier" model="res.groups">
        <field name="name">Caissier</field>
        <field name="category_id" ref="module_category_seyal"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Encaissements et decaissements de caisse.</field>
    </record>

    <record id="group_seyal_rh" model="res.groups">
        <field name="name">RH</field>
        <field name="category_id" ref="module_category_seyal"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Employes, presence, conges, avances, salaires.</field>
    </record>

    <record id="group_seyal_responsable_agence" model="res.groups">
        <field name="name">Responsable d'agence</field>
        <field name="category_id" ref="module_category_seyal"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Gestion operationnelle large, restreinte aux agences assignees (seyal_branch_ids).</field>
    </record>

    <record id="group_seyal_direction_generale" model="res.groups">
        <field name="name">Direction generale</field>
        <field name="category_id" ref="module_category_seyal"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Lecture seule sur tout, vue consolidee multi-agences, tableau de bord direction.</field>
    </record>
</odoo>
