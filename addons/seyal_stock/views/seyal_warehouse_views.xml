<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seyal_warehouse_tree" model="ir.ui.view">
        <field name="name">seyal.warehouse.tree</field>
        <field name="model">seyal.warehouse</field>
        <field name="arch" type="xml">
            <tree string="Entrepots">
                <field name="code"/>
                <field name="name"/>
                <field name="branch_id"/>
                <field name="address"/>
                <field name="active" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_seyal_warehouse_form" model="ir.ui.view">
        <field name="name">seyal.warehouse.form</field>
        <field name="model">seyal.warehouse</field>
        <field name="arch" type="xml">
            <form string="Entrepot">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="branch_id"/>
                        <field name="address"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_seyal_warehouse" model="ir.actions.act_window">
        <field name="name">Entrepots</field>
        <field name="res_model">seyal.warehouse</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
