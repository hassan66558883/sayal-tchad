<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seyal_stock_lot_tree" model="ir.ui.view">
        <field name="name">seyal.stock.lot.tree</field>
        <field name="model">seyal.stock.lot</field>
        <field name="arch" type="xml">
            <tree string="Lots">
                <field name="name"/>
                <field name="product_id"/>
                <field name="production_date"/>
                <field name="expiry_date"/>
            </tree>
        </field>
    </record>

    <record id="view_seyal_stock_lot_form" model="ir.ui.view">
        <field name="name">seyal.stock.lot.form</field>
        <field name="model">seyal.stock.lot</field>
        <field name="arch" type="xml">
            <form string="Lot">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="product_id"/>
                        <field name="production_date"/>
                        <field name="expiry_date"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_seyal_stock_lot" model="ir.actions.act_window">
        <field name="name">Lots</field>
        <field name="res_model">seyal.stock.lot</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
