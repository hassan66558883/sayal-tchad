<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seyal_stock_move_tree" model="ir.ui.view">
        <field name="name">seyal.stock.move.tree</field>
        <field name="model">seyal.stock.move</field>
        <field name="arch" type="xml">
            <tree string="Mouvements de stock" decoration-muted="state == 'cancelled'">
                <field name="reference"/>
                <field name="move_date"/>
                <field name="product_id"/>
                <field name="move_type"/>
                <field name="qty"/>
                <field name="source_warehouse_id"/>
                <field name="dest_warehouse_id"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_seyal_stock_move_form" model="ir.ui.view">
        <field name="name">seyal.stock.move.form</field>
        <field name="model">seyal.stock.move</field>
        <field name="arch" type="xml">
            <form string="Mouvement de stock">
                <header>
                    <button name="action_validate" type="object" string="Valider" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label text-muted">Reference</span>
                        <h1><field name="reference" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Mouvement">
                            <field name="move_date"/>
                            <field name="product_id"/>
                            <field name="lot_id"/>
                            <field name="qty"/>
                            <field name="move_type"/>
                        </group>
                        <group string="Entrepots">
                            <field name="source_warehouse_id"/>
                            <field name="dest_warehouse_id"/>
                            <field name="origin_import_id"/>
                            <field name="reason"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_seyal_stock_move_search" model="ir.ui.view">
        <field name="name">seyal.stock.move.search</field>
        <field name="model">seyal.stock.move</field>
        <field name="arch" type="xml">
            <search string="Mouvements de stock">
                <field name="reference"/>
                <field name="product_id"/>
                <field name="source_warehouse_id"/>
                <field name="dest_warehouse_id"/>
                <filter string="Brouillon" name="filter_draft" domain="[('state','=','draft')]"/>
                <filter string="Valides" name="filter_done" domain="[('state','=','done')]"/>
                <group expand="0" string="Grouper par">
                    <filter string="Produit" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'move_type'}"/>
                    <filter string="Statut" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_seyal_stock_move" model="ir.actions.act_window">
        <field name="name">Mouvements de stock</field>
        <field name="res_model">seyal.stock.move</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
