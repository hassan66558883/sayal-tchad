<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seyal_product_form_inherit_stock" model="ir.ui.view">
        <field name="name">seyal.product.form.inherit.stock</field>
        <field name="model">seyal.product</field>
        <field name="inherit_id" ref="seyal_product.view_seyal_product_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_stock']" position="inside">
                <field name="qty_on_hand"/>
                <field name="qty_in_transit"/>
            </xpath>
        </field>
    </record>

    <record id="view_seyal_product_tree_inherit_stock" model="ir.ui.view">
        <field name="name">seyal.product.tree.inherit.stock</field>
        <field name="model">seyal.product</field>
        <field name="inherit_id" ref="seyal_product.view_seyal_product_tree"/>
        <field name="arch" type="xml">
            <field name="min_stock_qty" position="after">
                <field name="qty_on_hand"/>
            </field>
        </field>
    </record>
</odoo>
