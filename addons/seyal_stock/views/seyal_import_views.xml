<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seyal_import_form_inherit_stock" model="ir.ui.view">
        <field name="name">seyal.import.form.inherit.stock</field>
        <field name="model">seyal.import</field>
        <field name="inherit_id" ref="seyal_purchase.view_seyal_import_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(seyal_stock.action_seyal_stock_reception_wizard)d" type="action"
                        string="Receptionner en stock" class="oe_highlight"
                        context="{'default_import_id': id}"
                        invisible="state != 'receptionne'"/>
            </xpath>
        </field>
    </record>
</odoo>
