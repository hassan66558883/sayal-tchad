<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seyal_stock_inventory_tree" model="ir.ui.view">
        <field name="name">seyal.stock.inventory.tree</field>
        <field name="model">seyal.stock.inventory</field>
        <field name="arch" type="xml">
            <tree string="Inventaires">
                <field name="reference"/>
                <field name="warehouse_id"/>
                <field name="inventory_date"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_seyal_stock_inventory_form" model="ir.ui.view">
        <field name="name">seyal.stock.inventory.form</field>
        <field name="model">seyal.stock.inventory</field>
        <field name="arch" type="xml">
            <form string="Inventaire">
                <header>
                    <button name="action_validate" type="object" string="Valider" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label text-muted">Reference</span>
                        <h1><field name="reference" readonly="1"/></h1>
                    </div>
                    <group>
                        <field name="warehouse_id"/>
                        <field name="inventory_date"/>
                    </group>
                    <notebook>
                        <page string="Lignes">
                            <field name="line_ids" readonly="state != 'draft'">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="lot_id"/>
                                    <field name="system_qty" readonly="1"/>
                                    <field name="counted_qty"/>
                                    <field name="difference" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_seyal_stock_inventory" model="ir.actions.act_window">
        <field name="name">Inventaires</field>
        <field name="res_model">seyal.stock.inventory</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
