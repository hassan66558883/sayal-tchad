<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Permissions par entrepot (cahier des charges, section Securite) :
        meme principe que rule_seyal_branch_responsable_agence
        (seyal_security, permissions par agence) et
        rule_seyal_delivery_route_chauffeur (seyal_delivery) - ir.rule filtre
        les LIGNES parmi ce que ir.model.access accorde deja au role
        "Stock / Entrepot" (seyal_security.group_seyal_stock), via
        res.users.seyal_warehouse_ids (voir models/res_users.py). Un
        utilisateur sans entrepot assigne ne voit aucun entrepot ni aucun
        mouvement/inventaire - deliberement, pas de repli implicite vers
        "tout voir". base.group_system n'est jamais concerne par une
        ir.rule (voir groups ci-dessous), comme partout ailleurs dans ce
        projet.
    -->
    <record id="rule_seyal_warehouse_stock" model="ir.rule">
        <field name="name">Stock/Entrepot : uniquement ses entrepots</field>
        <field name="model_id" ref="model_seyal_warehouse"/>
        <field name="domain_force">[('id', 'in', user.seyal_warehouse_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('seyal_security.group_seyal_stock'))]"/>
    </record>

    <record id="rule_seyal_stock_move_stock" model="ir.rule">
        <field name="name">Stock/Entrepot : mouvements de ses entrepots</field>
        <field name="model_id" ref="model_seyal_stock_move"/>
        <field name="domain_force">
            ['|',
             ('source_warehouse_id', 'in', user.seyal_warehouse_ids.ids),
             ('dest_warehouse_id', 'in', user.seyal_warehouse_ids.ids)]
        </field>
        <field name="groups" eval="[(4, ref('seyal_security.group_seyal_stock'))]"/>
    </record>

    <record id="rule_seyal_stock_inventory_stock" model="ir.rule">
        <field name="name">Stock/Entrepot : inventaires de ses entrepots</field>
        <field name="model_id" ref="model_seyal_stock_inventory"/>
        <field name="domain_force">[('warehouse_id', 'in', user.seyal_warehouse_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('seyal_security.group_seyal_stock'))]"/>
    </record>
</odoo>
