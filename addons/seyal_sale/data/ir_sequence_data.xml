<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_seyal_sale_order" model="ir.sequence">
        <field name="name">Commande de vente SEYAL-TCHAD</field>
        <field name="code">seyal.sale.order</field>
        <field name="prefix">DEV</field>
        <field name="padding">6</field>
    </record>

    <record id="seq_seyal_invoice" model="ir.sequence">
        <field name="name">Facture SEYAL-TCHAD</field>
        <field name="code">seyal.invoice</field>
        <field name="prefix">FAC</field>
        <field name="padding">6</field>
    </record>

    <record id="seq_seyal_payment" model="ir.sequence">
        <field name="name">Paiement SEYAL-TCHAD</field>
        <field name="code">seyal.payment</field>
        <field name="prefix">PAY</field>
        <field name="padding">6</field>
    </record>
</odoo>
