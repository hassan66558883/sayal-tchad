<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Permissions par agence (cahier des charges, section Securite),
         meme principe qu'en Phase 1 (seyal.branch) et sur seyal.partner
         (seyal_partner, Phase 12). Cible uniquement le role "Responsable
         d'agence" : les roles Ventes/Comptable gardent l'acces deja
         accorde (Phase 5), aucune regression pour eux. -->
    <record id="rule_seyal_sale_order_responsable_agence" model="ir.rule">
        <field name="name">Responsable d'agence : uniquement les commandes de son agence</field>
        <field name="model_id" ref="model_seyal_sale_order"/>
        <field name="domain_force">[('branch_id', 'in', user.seyal_branch_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('seyal_security.group_seyal_responsable_agence'))]"/>
    </record>
</odoo>
