<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seyal_invoice_tree" model="ir.ui.view">
        <field name="name">seyal.invoice.tree</field>
        <field name="model">seyal.invoice</field>
        <field name="arch" type="xml">
            <tree string="Factures" decoration-muted="state == 'cancelled'">
                <field name="reference"/>
                <field name="move_type"/>
                <field name="customer_id"/>
                <field name="invoice_date"/>
                <field name="amount_total" sum="Total"/>
                <field name="amount_due" sum="Reste a payer"/>
                <field name="payment_state" widget="badge"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_seyal_invoice_form" model="ir.ui.view">
        <field name="name">seyal.invoice.form</field>
        <field name="model">seyal.invoice</field>
        <field name="arch" type="xml">
            <form string="Facture">
                <header>
                    <button name="action_validate" type="object" string="Valider" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label text-muted">Reference</span>
                        <h1><field name="reference" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Informations generales">
                            <field name="move_type"/>
                            <field name="customer_id"/>
                            <field name="invoice_date"/>
                            <field name="sale_order_id"/>
                            <field name="origin_invoice_id" invisible="move_type != 'credit_note'"/>
                        </group>
                        <group string="Paiement">
                            <field name="amount_total"/>
                            <field name="amount_paid"/>
                            <field name="amount_due"/>
                            <field name="payment_state" widget="badge"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lignes">
                            <field name="line_ids" readonly="state != 'draft'">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="qty"/>
                                    <field name="unit_price"/>
                                    <field name="discount_percent"/>
                                    <field name="subtotal" sum="Total"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_seyal_invoice_search" model="ir.ui.view">
        <field name="name">seyal.invoice.search</field>
        <field name="model">seyal.invoice</field>
        <field name="arch" type="xml">
            <search string="Factures">
                <field name="reference"/>
                <field name="customer_id"/>
                <filter string="Factures" name="filter_invoices" domain="[('move_type','=','invoice')]"/>
                <filter string="Avoirs" name="filter_credit_notes" domain="[('move_type','=','credit_note')]"/>
                <filter string="Non payees" name="filter_not_paid" domain="[('payment_state','=','not_paid')]"/>
                <filter string="Partiellement payees" name="filter_partial"
                        domain="[('payment_state','=','partially_paid')]"/>
                <group expand="0" string="Grouper par">
                    <filter string="Client" name="group_customer" context="{'group_by': 'customer_id'}"/>
                    <filter string="Etat du paiement" name="group_payment_state"
                            context="{'group_by': 'payment_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_seyal_invoice" model="ir.actions.act_window">
        <field name="name">Factures</field>
        <field name="res_model">seyal.invoice</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
