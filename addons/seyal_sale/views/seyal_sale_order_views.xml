<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seyal_sale_order_tree" model="ir.ui.view">
        <field name="name">seyal.sale.order.tree</field>
        <field name="model">seyal.sale.order</field>
        <field name="arch" type="xml">
            <tree string="Commandes de vente" decoration-muted="state == 'cancelled'">
                <field name="reference"/>
                <field name="customer_id"/>
                <field name="order_date"/>
                <field name="salesperson_id"/>
                <field name="amount_total" sum="Total"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_seyal_sale_order_form" model="ir.ui.view">
        <field name="name">seyal.sale.order.form</field>
        <field name="model">seyal.sale.order</field>
        <field name="arch" type="xml">
            <form string="Commande de vente">
                <header>
                    <button name="action_confirm" type="object" string="Confirmer" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_create_invoice" type="object" string="Creer facture" class="oe_highlight"
                            invisible="state not in ('confirmed', 'done')"/>
                    <button name="action_done" type="object" string="Marquer terminee"
                            invisible="state != 'confirmed'"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset_to_draft" type="object" string="Remettre en devis"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label text-muted">Reference</span>
                        <h1><field name="reference" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Informations generales">
                            <field name="customer_id"/>
                            <field name="order_date"/>
                            <field name="branch_id"/>
                            <field name="salesperson_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lignes">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="qty"/>
                                    <field name="unit_price"/>
                                    <field name="discount_percent"/>
                                    <field name="subtotal" sum="Total"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_total"/>
                            </group>
                        </page>
                        <page string="Factures">
                            <field name="invoice_ids">
                                <tree>
                                    <field name="reference"/>
                                    <field name="invoice_date"/>
                                    <field name="amount_total"/>
                                    <field name="payment_state" widget="badge"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_seyal_sale_order_search" model="ir.ui.view">
        <field name="name">seyal.sale.order.search</field>
        <field name="model">seyal.sale.order</field>
        <field name="arch" type="xml">
            <search string="Commandes de vente">
                <field name="reference"/>
                <field name="customer_id"/>
                <field name="salesperson_id"/>
                <filter string="Devis" name="filter_draft" domain="[('state','=','draft')]"/>
                <filter string="Confirmees" name="filter_confirmed" domain="[('state','=','confirmed')]"/>
                <group expand="0" string="Grouper par">
                    <filter string="Client" name="group_customer" context="{'group_by': 'customer_id'}"/>
                    <filter string="Commercial" name="group_salesperson" context="{'group_by': 'salesperson_id'}"/>
                    <filter string="Statut" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_seyal_sale_order" model="ir.actions.act_window">
        <field name="name">Devis / Commandes</field>
        <field name="res_model">seyal.sale.order</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
