<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seyal_payment_tree" model="ir.ui.view">
        <field name="name">seyal.payment.tree</field>
        <field name="model">seyal.payment</field>
        <field name="arch" type="xml">
            <tree string="Paiements" decoration-muted="state == 'cancelled'">
                <field name="reference"/>
                <field name="invoice_id"/>
                <field name="customer_id"/>
                <field name="payment_date"/>
                <field name="amount" sum="Total"/>
                <field name="method"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_seyal_payment_form" model="ir.ui.view">
        <field name="name">seyal.payment.form</field>
        <field name="model">seyal.payment</field>
        <field name="arch" type="xml">
            <form string="Paiement">
                <header>
                    <button name="action_confirm" type="object" string="Confirmer" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label text-muted">Reference</span>
                        <h1><field name="reference" readonly="1"/></h1>
                    </div>
                    <group>
                        <field name="invoice_id"/>
                        <field name="customer_id" readonly="1"/>
                        <field name="payment_date"/>
                        <field name="amount"/>
                        <field name="method"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_seyal_payment" model="ir.actions.act_window">
        <field name="name">Paiements</field>
        <field name="res_model">seyal.payment</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
