<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seyal_commission_rule_tree" model="ir.ui.view">
        <field name="name">seyal.commission.rule.tree</field>
        <field name="model">seyal.commission.rule</field>
        <field name="arch" type="xml">
            <tree string="Baremes de commission">
                <field name="name"/>
                <field name="salesperson_id"/>
                <field name="rate_percent"/>
                <field name="active" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_seyal_commission_rule_form" model="ir.ui.view">
        <field name="name">seyal.commission.rule.form</field>
        <field name="model">seyal.commission.rule</field>
        <field name="arch" type="xml">
            <form string="Bareme de commission">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="salesperson_id"/>
                        <field name="rate_percent"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_seyal_commission_rule" model="ir.actions.act_window">
        <field name="name">Baremes de commission</field>
        <field name="res_model">seyal.commission.rule</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
