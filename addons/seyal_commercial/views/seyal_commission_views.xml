<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seyal_commission_tree" model="ir.ui.view">
        <field name="name">seyal.commission.tree</field>
        <field name="model">seyal.commission</field>
        <field name="arch" type="xml">
            <tree string="Commissions" decoration-muted="state == 'cancelled'">
                <field name="reference"/>
                <field name="salesperson_id"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="base_amount"/>
                <field name="rate_percent"/>
                <field name="commission_amount" sum="Total"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_seyal_commission_form" model="ir.ui.view">
        <field name="name">seyal.commission.form</field>
        <field name="model">seyal.commission</field>
        <field name="arch" type="xml">
            <form string="Commission commerciale">
                <header>
                    <button name="action_compute" type="object" string="Calculer" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_validate" type="object" string="Valider" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label text-muted">Reference</span>
                        <h1><field name="reference" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Periode">
                            <field name="salesperson_id"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                        </group>
                        <group string="Calcul">
                            <field name="rate_percent"/>
                            <field name="base_amount" readonly="1"/>
                            <field name="commission_amount" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_seyal_commission" model="ir.actions.act_window">
        <field name="name">Commissions</field>
        <field name="res_model">seyal.commission</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
