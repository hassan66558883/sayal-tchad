<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seyal_product_category_tree" model="ir.ui.view">
        <field name="name">seyal.product.category.tree</field>
        <field name="model">seyal.product.category</field>
        <field name="arch" type="xml">
            <tree string="Categories de produits">
                <field name="code"/>
                <field name="complete_name"/>
                <field name="parent_id"/>
                <field name="active" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_seyal_product_category_form" model="ir.ui.view">
        <field name="name">seyal.product.category.form</field>
        <field name="model">seyal.product.category</field>
        <field name="arch" type="xml">
            <form string="Categorie de produit">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="parent_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_seyal_product_category" model="ir.actions.act_window">
        <field name="name">Categories de produits</field>
        <field name="res_model">seyal.product.category</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
