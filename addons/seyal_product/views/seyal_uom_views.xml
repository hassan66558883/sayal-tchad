<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seyal_uom_category_tree" model="ir.ui.view">
        <field name="name">seyal.uom.category.tree</field>
        <field name="model">seyal.uom.category</field>
        <field name="arch" type="xml">
            <tree string="Categories d'unites de mesure">
                <field name="name"/>
                <field name="active" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="action_seyal_uom_category" model="ir.actions.act_window">
        <field name="name">Categories d'unites de mesure</field>
        <field name="res_model">seyal.uom.category</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_seyal_uom_tree" model="ir.ui.view">
        <field name="name">seyal.uom.tree</field>
        <field name="model">seyal.uom</field>
        <field name="arch" type="xml">
            <tree string="Unites de mesure">
                <field name="name"/>
                <field name="category_id"/>
                <field name="factor"/>
                <field name="is_reference"/>
                <field name="active" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_seyal_uom_form" model="ir.ui.view">
        <field name="name">seyal.uom.form</field>
        <field name="model">seyal.uom</field>
        <field name="arch" type="xml">
            <form string="Unite de mesure">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category_id"/>
                        <field name="is_reference"/>
                        <field name="factor"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_seyal_uom" model="ir.actions.act_window">
        <field name="name">Unites de mesure</field>
        <field name="res_model">seyal.uom</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
