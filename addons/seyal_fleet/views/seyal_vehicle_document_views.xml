<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seyal_vehicle_document_tree" model="ir.ui.view">
        <field name="name">seyal.vehicle.document.tree</field>
        <field name="model">seyal.vehicle.document</field>
        <field name="arch" type="xml">
            <tree string="Documents vehicules">
                <field name="vehicle_id"/>
                <field name="name"/>
                <field name="document_type"/>
                <field name="expiry_date"/>
            </tree>
        </field>
    </record>

    <record id="view_seyal_vehicle_document_form" model="ir.ui.view">
        <field name="name">seyal.vehicle.document.form</field>
        <field name="model">seyal.vehicle.document</field>
        <field name="arch" type="xml">
            <form string="Document vehicule">
                <sheet>
                    <group>
                        <field name="vehicle_id"/>
                        <field name="name"/>
                        <field name="document_type"/>
                        <field name="expiry_date"/>
                        <field name="file" filename="filename"/>
                        <field name="filename" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_seyal_vehicle_document" model="ir.actions.act_window">
        <field name="name">Documents vehicules</field>
        <field name="res_model">seyal.vehicle.document</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
