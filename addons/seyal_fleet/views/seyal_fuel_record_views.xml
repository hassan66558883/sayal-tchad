<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seyal_fuel_record_tree" model="ir.ui.view">
        <field name="name">seyal.fuel.record.tree</field>
        <field name="model">seyal.fuel.record</field>
        <field name="arch" type="xml">
            <tree string="Pleins de carburant">
                <field name="reference"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="record_date"/>
                <field name="odometer_km"/>
                <field name="qty_liters"/>
                <field name="amount" sum="Total"/>
            </tree>
        </field>
    </record>

    <record id="view_seyal_fuel_record_form" model="ir.ui.view">
        <field name="name">seyal.fuel.record.form</field>
        <field name="model">seyal.fuel.record</field>
        <field name="arch" type="xml">
            <form string="Plein de carburant">
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label text-muted">Reference</span>
                        <h1><field name="reference" readonly="1"/></h1>
                    </div>
                    <group>
                        <field name="vehicle_id"/>
                        <field name="driver_id"/>
                        <field name="record_date"/>
                        <field name="odometer_km"/>
                        <field name="qty_liters"/>
                        <field name="unit_price"/>
                        <field name="amount"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_seyal_fuel_record" model="ir.actions.act_window">
        <field name="name">Pleins de carburant</field>
        <field name="res_model">seyal.fuel.record</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
