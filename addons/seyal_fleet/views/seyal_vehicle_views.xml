<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seyal_vehicle_form_inherit_fleet" model="ir.ui.view">
        <field name="name">seyal.vehicle.form.inherit.fleet</field>
        <field name="model">seyal.vehicle</field>
        <field name="inherit_id" ref="seyal_delivery.view_seyal_vehicle_form"/>
        <field name="arch" type="xml">
            <field name="capacity_kg" position="after">
                <field name="total_km"/>
                <field name="total_fuel_liters"/>
                <field name="total_fuel_cost"/>
                <field name="avg_consumption_l_per_100km"/>
                <field name="cost_per_km"/>
            </field>
            <sheet position="inside">
                <notebook>
                    <page string="Carburant">
                        <field name="fuel_record_ids" readonly="1">
                            <tree>
                                <field name="record_date"/>
                                <field name="odometer_km"/>
                                <field name="qty_liters"/>
                                <field name="amount"/>
                            </tree>
                        </field>
                    </page>
                    <page string="Entretien">
                        <field name="maintenance_ids" readonly="1">
                            <tree>
                                <field name="maintenance_date"/>
                                <field name="description"/>
                                <field name="cost"/>
                            </tree>
                        </field>
                    </page>
                    <page string="Assurance">
                        <field name="insurance_ids" readonly="1">
                            <tree>
                                <field name="policy_number"/>
                                <field name="start_date"/>
                                <field name="end_date"/>
                            </tree>
                        </field>
                    </page>
                    <page string="Documents">
                        <field name="document_ids" readonly="1">
                            <tree>
                                <field name="name"/>
                                <field name="document_type"/>
                                <field name="expiry_date"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </sheet>
        </field>
    </record>
</odoo>
