<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seyal_vehicle_maintenance_tree" model="ir.ui.view">
        <field name="name">seyal.vehicle.maintenance.tree</field>
        <field name="model">seyal.vehicle.maintenance</field>
        <field name="arch" type="xml">
            <tree string="Entretiens">
                <field name="vehicle_id"/>
                <field name="maintenance_date"/>
                <field name="description"/>
                <field name="odometer_km"/>
                <field name="cost" sum="Total"/>
            </tree>
        </field>
    </record>

    <record id="view_seyal_vehicle_maintenance_form" model="ir.ui.view">
        <field name="name">seyal.vehicle.maintenance.form</field>
        <field name="model">seyal.vehicle.maintenance</field>
        <field name="arch" type="xml">
            <form string="Entretien">
                <sheet>
                    <group>
                        <field name="vehicle_id"/>
                        <field name="maintenance_date"/>
                        <field name="description"/>
                        <field name="odometer_km"/>
                        <field name="cost"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_seyal_vehicle_maintenance" model="ir.actions.act_window">
        <field name="name">Entretiens</field>
        <field name="res_model">seyal.vehicle.maintenance</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
