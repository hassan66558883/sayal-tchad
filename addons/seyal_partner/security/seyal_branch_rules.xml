<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Permissions par agence (cahier des charges, section Securite) :
         meme principe que rule_seyal_branch_responsable_agence
         (seyal_security, Phase 1), applique ici au role "Responsable
         d'agence" sur les tiers (clients/fournisseurs) via
         seyal.partner.branch_id / res.users.seyal_branch_ids. Un
         utilisateur sans agence assignee ne voit aucun tiers - deliberement,
         pas de repli implicite vers "tout voir". Les roles Ventes/Achats
         gardent l'acces large deja accorde (Phase 2), aucune regression
         pour eux : cette regle ne cible que group_seyal_responsable_agence. -->
    <record id="rule_seyal_partner_responsable_agence" model="ir.rule">
        <field name="name">Responsable d'agence : uniquement les tiers de son agence</field>
        <field name="model_id" ref="model_seyal_partner"/>
        <field name="domain_force">[('branch_id', 'in', user.seyal_branch_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('seyal_security.group_seyal_responsable_agence'))]"/>
    </record>
</odoo>
