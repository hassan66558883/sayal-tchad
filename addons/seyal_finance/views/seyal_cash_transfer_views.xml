<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seyal_cash_transfer_tree" model="ir.ui.view">
        <field name="name">seyal.cash.transfer.tree</field>
        <field name="model">seyal.cash.transfer</field>
        <field name="arch" type="xml">
            <tree string="Transferts Caisse/Banque">
                <field name="reference"/>
                <field name="direction"/>
                <field name="cash_account_id"/>
                <field name="bank_account_id"/>
                <field name="transfer_date"/>
                <field name="amount"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_seyal_cash_transfer_form" model="ir.ui.view">
        <field name="name">seyal.cash.transfer.form</field>
        <field name="model">seyal.cash.transfer</field>
        <field name="arch" type="xml">
            <form string="Transfert Caisse/Banque">
                <header>
                    <button name="action_confirm" type="object" string="Confirmer" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label text-muted">Reference</span>
                        <h1><field name="reference" readonly="1"/></h1>
                    </div>
                    <group>
                        <field name="direction"/>
                        <field name="cash_account_id"/>
                        <field name="bank_account_id"/>
                        <field name="transfer_date"/>
                        <field name="amount"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_seyal_cash_transfer" model="ir.actions.act_window">
        <field name="name">Transferts Caisse/Banque</field>
        <field name="res_model">seyal.cash.transfer</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
