<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seyal_supplier_bill_tree" model="ir.ui.view">
        <field name="name">seyal.supplier.bill.tree</field>
        <field name="model">seyal.supplier.bill</field>
        <field name="arch" type="xml">
            <tree string="Factures fournisseurs" decoration-muted="state == 'cancelled'">
                <field name="reference"/>
                <field name="supplier_id"/>
                <field name="bill_date"/>
                <field name="amount_total" sum="Total"/>
                <field name="amount_due" sum="Reste a payer"/>
                <field name="payment_state" widget="badge"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_seyal_supplier_bill_form" model="ir.ui.view">
        <field name="name">seyal.supplier.bill.form</field>
        <field name="model">seyal.supplier.bill</field>
        <field name="arch" type="xml">
            <form string="Facture fournisseur">
                <header>
                    <button name="action_validate" type="object" string="Valider" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label text-muted">Reference</span>
                        <h1><field name="reference" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Informations generales">
                            <field name="supplier_id"/>
                            <field name="bill_date"/>
                            <field name="purchase_order_id"/>
                        </group>
                        <group string="Paiement">
                            <field name="amount_total"/>
                            <field name="amount_paid"/>
                            <field name="amount_due"/>
                            <field name="payment_state" widget="badge"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lignes">
                            <field name="line_ids" readonly="state != 'draft'">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="qty"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal" sum="Total"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_seyal_supplier_bill" model="ir.actions.act_window">
        <field name="name">Factures fournisseurs</field>
        <field name="res_model">seyal.supplier.bill</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
