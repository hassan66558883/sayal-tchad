<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seyal_driver_tree" model="ir.ui.view">
        <field name="name">seyal.driver.tree</field>
        <field name="model">seyal.driver</field>
        <field name="arch" type="xml">
            <tree string="Chauffeurs">
                <field name="name"/>
                <field name="license_number"/>
                <field name="phone"/>
                <field name="vehicle_id"/>
                <field name="user_id"/>
            </tree>
        </field>
    </record>

    <record id="view_seyal_driver_form" model="ir.ui.view">
        <field name="name">seyal.driver.form</field>
        <field name="model">seyal.driver</field>
        <field name="arch" type="xml">
            <form string="Chauffeur">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="license_number"/>
                        <field name="phone"/>
                        <field name="vehicle_id"/>
                        <field name="user_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_seyal_driver" model="ir.actions.act_window">
        <field name="name">Chauffeurs</field>
        <field name="res_model">seyal.driver</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
