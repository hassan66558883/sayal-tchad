<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seyal_delivery_route_tree" model="ir.ui.view">
        <field name="name">seyal.delivery.route.tree</field>
        <field name="model">seyal.delivery.route</field>
        <field name="arch" type="xml">
            <tree string="Tournees">
                <field name="reference"/>
                <field name="route_date"/>
                <field name="driver_id"/>
                <field name="vehicle_id"/>
                <field name="branch_id"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_seyal_delivery_route_form" model="ir.ui.view">
        <field name="name">seyal.delivery.route.form</field>
        <field name="model">seyal.delivery.route</field>
        <field name="arch" type="xml">
            <form string="Tournee de livraison">
                <header>
                    <button name="action_charger" type="object" string="Charger" class="oe_highlight"
                            invisible="state != 'planifiee'"/>
                    <button name="action_demarrer" type="object" string="Demarrer" class="oe_highlight"
                            invisible="state != 'chargee'"/>
                    <button name="action_terminer" type="object" string="Terminer" class="oe_highlight"
                            invisible="state != 'en_livraison'"/>
                    <button name="action_cloturer" type="object" string="Cloturer" class="oe_highlight"
                            invisible="state != 'livree'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="planifiee,chargee,en_livraison,livree,cloturee"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label text-muted">Reference</span>
                        <h1><field name="reference" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Affectation">
                            <field name="route_date"/>
                            <field name="driver_id"/>
                            <field name="vehicle_id"/>
                        </group>
                        <group string="Logistique">
                            <field name="branch_id"/>
                            <field name="warehouse_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Livraisons">
                            <field name="delivery_ids">
                                <tree>
                                    <field name="reference"/>
                                    <field name="customer_id"/>
                                    <field name="sale_order_id"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_seyal_delivery_route" model="ir.actions.act_window">
        <field name="name">Tournees</field>
        <field name="res_model">seyal.delivery.route</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
