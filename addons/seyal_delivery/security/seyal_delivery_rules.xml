<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Meme principe que rule_seyal_branch_responsable_agence
        (seyal_security) : restreint les LIGNES visibles pour le role
        Chauffeur a ses propres tournees/livraisons, via seyal.driver.user_id
        (le compte utilisateur lie a la fiche chauffeur). Un chauffeur sans
        compte lie, ou dont la fiche n'est reliee a aucune tournee, ne voit
        rien - deliberement, pas de repli implicite vers "tout voir".
    -->
    <record id="rule_seyal_delivery_route_chauffeur" model="ir.rule">
        <field name="name">Chauffeur : uniquement ses tournees</field>
        <field name="model_id" ref="model_seyal_delivery_route"/>
        <field name="domain_force">[('driver_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('seyal_security.group_seyal_chauffeur'))]"/>
    </record>

    <record id="rule_seyal_delivery_chauffeur" model="ir.rule">
        <field name="name">Chauffeur : uniquement ses livraisons</field>
        <field name="model_id" ref="model_seyal_delivery"/>
        <field name="domain_force">[('route_id.driver_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('seyal_security.group_seyal_chauffeur'))]"/>
    </record>
</odoo>
