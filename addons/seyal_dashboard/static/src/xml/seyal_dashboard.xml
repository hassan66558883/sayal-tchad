<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="seyal_dashboard.DashboardTemplate">
        <div class="o_seyal_dashboard">
            <div class="o_seyal_dashboard_header">
                <h2>Tableau de bord Direction - SEYAL-TCHAD</h2>
                <span class="o_seyal_dashboard_subtitle">Vue d'ensemble en temps reel de l'activite</span>
            </div>

            <div t-if="state.loading" class="o_seyal_dashboard_loading">Chargement des indicateurs...</div>

            <t t-if="!state.loading and state.kpis">
                <t t-foreach="sections" t-as="section" t-key="section.title">
                    <section class="o_seyal_dashboard_section">
                        <h3 class="o_seyal_dashboard_section_title"><t t-esc="section.title"/></h3>
                        <div class="o_seyal_dashboard_grid">
                            <t t-foreach="section.tiles" t-as="tile" t-key="tile.key">
                                <div t-attf-class="o_seyal_dashboard_tile o_seyal_dashboard_tile_{{ tile.tone }}">
                                    <div class="o_seyal_dashboard_tile_icon">
                                        <i t-attf-class="fa {{ tile.icon }}"/>
                                    </div>
                                    <div class="o_seyal_dashboard_tile_content">
                                        <span class="o_seyal_dashboard_value">
                                            <t t-esc="formatValue(state.kpis[tile.key])"/>
                                        </span>
                                        <span class="o_seyal_dashboard_label"><t t-esc="tile.label"/></span>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </section>
                </t>

                <section class="o_seyal_dashboard_section">
                    <div class="o_seyal_dashboard_chart_header">
                        <h3 class="o_seyal_dashboard_section_title">Chiffre d'affaires et encaissements par jour</h3>
                        <div class="o_seyal_dashboard_days_buttons">
                            <t t-foreach="dailyDaysOptions" t-as="d" t-key="d">
                                <button type="button"
                                        t-attf-class="btn btn-sm {{ state.dailyDays === d ? 'btn-primary' : 'btn-outline-secondary' }}"
                                        t-on-click="() => this.onDailyDaysChange(d)">
                                    <t t-esc="d"/> j
                                </button>
                            </t>
                        </div>
                    </div>
                    <div class="o_seyal_dashboard_chart_container">
                        <canvas t-ref="dailyChart"/>
                    </div>
                </section>
            </t>
        </div>
    </t>
</templates>
