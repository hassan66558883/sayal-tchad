<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Permissions par agence (cahier des charges, section Securite),
         meme principe que sur seyal.partner/seyal.sale.order (Phase 12).
         Cible uniquement le role "Responsable d'agence" : le role Achats
         garde l'acces deja accorde (Phase 3), aucune regression pour lui. -->
    <record id="rule_seyal_purchase_order_responsable_agence" model="ir.rule">
        <field name="name">Responsable d'agence : uniquement les commandes d'achat de son agence</field>
        <field name="model_id" ref="model_seyal_purchase_order"/>
        <field name="domain_force">[('branch_id', 'in', user.seyal_branch_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('seyal_security.group_seyal_responsable_agence'))]"/>
    </record>
</odoo>
