<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seyal_import_tree" model="ir.ui.view">
        <field name="name">seyal.import.tree</field>
        <field name="model">seyal.import</field>
        <field name="arch" type="xml">
            <tree string="Importations">
                <field name="reference"/>
                <field name="supplier_id"/>
                <field name="bl_number"/>
                <field name="arrival_date"/>
                <field name="real_cost" sum="Total"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_seyal_import_form" model="ir.ui.view">
        <field name="name">seyal.import.form</field>
        <field name="model">seyal.import</field>
        <field name="arch" type="xml">
            <form string="Importation">
                <header>
                    <button name="action_expedier" type="object" string="Expedier" class="oe_highlight"
                            invisible="state != 'nouveau'"/>
                    <button name="action_arrivee" type="object" string="Marquer arrivee" class="oe_highlight"
                            invisible="state != 'expedie'"/>
                    <button name="action_douane" type="object" string="Passer en douane" class="oe_highlight"
                            invisible="state != 'arrive'"/>
                    <button name="action_receptionner" type="object" string="Receptionner" class="oe_highlight"
                            invisible="state != 'douane'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="nouveau,expedie,arrive,douane,receptionne"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label text-muted">Reference</span>
                        <h1><field name="reference" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Commande et fournisseur">
                            <field name="purchase_order_id"/>
                            <field name="supplier_id" readonly="1"/>
                            <field name="bl_number"/>
                        </group>
                        <group string="Transport">
                            <field name="port_of_loading"/>
                            <field name="port_of_discharge"/>
                            <field name="expedition_date"/>
                            <field name="arrival_date"/>
                        </group>
                    </group>
                    <group>
                        <group string="Frais annexes">
                            <field name="transport_cost"/>
                            <field name="customs_cost"/>
                            <field name="transit_cost"/>
                            <field name="other_costs"/>
                            <field name="total_extra_costs"/>
                        </group>
                        <group string="Cout reel">
                            <field name="purchase_amount"/>
                            <field name="real_cost"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Conteneurs">
                            <field name="container_ids">
                                <tree editable="bottom">
                                    <field name="number"/>
                                    <field name="container_type"/>
                                    <field name="seal_number"/>
                                    <field name="status"/>
                                    <field name="arrival_date"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_seyal_import_search" model="ir.ui.view">
        <field name="name">seyal.import.search</field>
        <field name="model">seyal.import</field>
        <field name="arch" type="xml">
            <search string="Importations">
                <field name="reference"/>
                <field name="supplier_id"/>
                <field name="bl_number"/>
                <group expand="0" string="Grouper par">
                    <filter string="Statut" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Fournisseur" name="group_supplier" context="{'group_by': 'supplier_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_seyal_import" model="ir.actions.act_window">
        <field name="name">Importations</field>
        <field name="res_model">seyal.import</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
