<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seyal_container_tree" model="ir.ui.view">
        <field name="name">seyal.container.tree</field>
        <field name="model">seyal.container</field>
        <field name="arch" type="xml">
            <tree string="Conteneurs">
                <field name="number"/>
                <field name="import_id"/>
                <field name="container_type"/>
                <field name="seal_number"/>
                <field name="status" widget="badge"/>
                <field name="arrival_date"/>
            </tree>
        </field>
    </record>

    <record id="view_seyal_container_form" model="ir.ui.view">
        <field name="name">seyal.container.form</field>
        <field name="model">seyal.container</field>
        <field name="arch" type="xml">
            <form string="Conteneur">
                <sheet>
                    <group>
                        <field name="number"/>
                        <field name="import_id"/>
                        <field name="container_type"/>
                        <field name="seal_number"/>
                        <field name="status"/>
                        <field name="arrival_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_seyal_container" model="ir.actions.act_window">
        <field name="name">Conteneurs</field>
        <field name="res_model">seyal.container</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
