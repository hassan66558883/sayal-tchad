# Copy to ".env" and fill in real values. Never commit ".env".

DATABASE_URL=postgresql+psycopg://seyal:change_me@localhost:5432/seyal_dev
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

COMPANY_NAME=SEYAL-TCHAD
COMPANY_CURRENCY=XAF

# Optional, one-time bootstrap: if set and no superuser exists yet, the
# app creates one on startup. Unset again once you have a real admin.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change_me
