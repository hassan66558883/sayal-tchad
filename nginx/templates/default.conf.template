# SEYAL-TCHAD ERP - reverse proxy TLS pour la production (HTTPS devant Odoo). Fichier "template" nginx : ${DOMAIN} est
# substitue automatiquement au demarrage du conteneur nginx:1.25-alpine
# officiel (envsubst sur /etc/nginx/templates/*.template), a partir de la
# variable d'environnement DOMAIN (voir docker-compose.prod.yml / .env).
#
# Pre-requis : le certificat Let's Encrypt pour ${DOMAIN} doit deja
# exister dans le volume certbot_certs avant le premier demarrage de ce
# conteneur (bootstrap via `certbot certonly --standalone`, voir README).
# Sans ca, nginx refuse de demarrer (fichier ssl_certificate introuvable).

server {
    listen 80;
    server_name ${DOMAIN};

    # Chemin de validation ACME pour le renouvellement automatique du
    # certificat (le service "certbot" du docker-compose.prod.yml sert ce
    # meme volume en mode webroot).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    # Pieces jointes (photos de compteurs, factures PDF) : autoriser des
    # uploads plus larges que la limite par defaut de nginx.
    client_max_body_size 100m;

    # Force le flag "Secure" sur le cookie de session, quelle que soit la
    # decision d'Odoo cote applicatif. Verifie manuellement qu'Odoo ne le
    # met PAS lui-meme meme avec X-Forwarded-Proto/-Host corrects (son
    # ProxyFix interne ne semble pas influencer cet aspect precis) - sans
    # cette ligne, le cookie de session serait rejouable si jamais servi
    # une fois en clair, ce que ce reverse proxy est justement cense
    # empecher.
    proxy_cookie_flags session_id secure;

    # Bus Odoo (notifications temps reel, longpolling/websocket) :
    # necessite l'upgrade de connexion, route separee du reste.
    # Odoo (odoo/http.py) n'active son support proxy (ProxyFix - lecture de
    # X-Forwarded-Proto/For pour generer des URLs en https://) QUE si
    # X-Forwarded-Host est aussi present, en plus de proxy_mode=True dans
    # odoo.conf. L'oublier fait silencieusement retomber Odoo sur des URLs
    # en http:// meme derriere ce proxy TLS.
    location /websocket {
        proxy_pass http://odoo:8069;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    location / {
        proxy_pass http://odoo:8069;
        proxy_redirect off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }
}
